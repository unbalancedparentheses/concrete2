// Bug 305: a `borrow mut` block pointed its reference at a copy of the owner and loaded the copy
// back into the owner only when the block fell through its end, so a `break`, `continue` or
// `return` leaving the block early lost the writes made through the reference. The reference is
// now the owner's own storage, as `&mut owner` is.
fn show(p: &i64, sink: &mut i64) {
    *sink = *p;
}

// A `break` out of the block, inside a loop.
fn brk(c: i64) -> i64 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < 3 {
        borrow mut n as r in R {
            *r = *r + 10;
            if i == c {
                break;
            }
        }
        i = i + 1;
    }
    return n * 100 + i;
}

// A `continue` out of the block.
fn cont() -> i64 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < 3 {
        i = i + 1;
        borrow mut n as r in R {
            *r = *r + 10;
            if i == 2 {
                continue;
            }
        }
    }
    return n;
}

// A labelled `break` out of two loops, from a block in the inner one.
fn labelled() -> i64 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    'outer: while i < 5 {
        i = i + 1;
        let mut j: i64 = 0;
        while j < 5 {
            j = j + 1;
            borrow mut n as r in R {
                *r = *r + 1;
                if *r == 7 {
                    break 'outer;
                }
            }
        }
    }
    return n;
}

// A `return` out of the block reads nothing of the owner, but the owner's value on that path is the
// one the loop exit carries in `brk`; here a second block after a conditional exit reads it.
fn after_exit(c: bool) -> i64 {
    let mut n: i64 = 1;
    let mut i: i64 = 0;
    while i < 1 {
        i = i + 1;
        borrow mut n as r in R {
            *r = 4;
            if c {
                break;
            }
            *r = 5;
        }
    }
    let mut out: i64 = 0;
    borrow n as s in S {
        show(s, &mut out);
    }
    return out;
}

fn main() -> Int {
    // brk(1) = 2001, brk(9) = 3003, cont() = 30, labelled() = 7, after_exit(true) = 4,
    // after_exit(false) = 5
    let t: i64 = brk(1) + brk(9) + cont() + labelled() + after_exit(true) + after_exit(false);
    return (t - 5008) as Int;
}
