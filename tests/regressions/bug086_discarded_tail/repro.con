// Bug 086 — a discarded `e;` is not the block's value, and a `return` nested in a non-tail
// expression leaves the function. check_model_diff.sh pins the values in the comments.
mod main {
    fn id(x: i32) -> i32 { return x; }
    // `id(x);` is a discarded statement; g returns 7 for every x (the model said x for x > 0).
    // Since 2026-10-24 it is extracted as evaluate-and-drop, and g(8) must read 7 on both sides.
    fn g(x: i32) -> i32 {
        if x > 0 {
            id(x);
        }
        return 7;
    }
    // A `return` inside a `let` initializer exits the function: letret(1) = 1 (the model said 11).
    // Since 2026-10-24 the code after the `let` is pushed into the branch that yields, and the
    // branch that returns is the result: letret(1) must read 1 on both sides.
    fn letret(x: i32) -> i32 {
        let y: i32 = if x > 0 { return 1; } else { 2 };
        return y + 10;
    }
    // (`argret`, a `return` inside a call argument, was here; the language refuses that shape since
    // bug 142, E0278, so it is a rejection fixture: tests/regressions/bug142_exit_in_operand.)
    // A statement-position match whose every arm returns IS the function's exit: extracted, and it
    // agrees (tailmatch(0) = 5, otherwise 6).
    fn tailmatch(x: i32) -> i32 {
        match x {
            0 => { return 5; },
            _ => { return 6; },
        }
    }
    // A tail `return if ...` whose branch returns: both are function returns. tailif(1) = 3.
    fn tailif(x: i32) -> i32 {
        return if x > 0 { return 3; } else { 4 };
    }
    pub fn main() -> i32 { return 0; }
}
