mod decls {
    // A BODY-LESS `pub trusted fn`. The parser carried `isPublic` on this branch and
    // dropped `isTrusted`, so this declaration reached `externFnRequiredCaps` as
    // UNTRUSTED and was charged `Unsafe` — a modifier the author wrote, discarded, with
    // the default `false` read as a decision. `std.mem.sizeof` is spelled this way.
    // CHECK-ONLY, deliberately. `#[intrinsic]` resolves by the compiler's own name
    // table, so a renamed copy is not an intrinsic and has no symbol to link — which is
    // fine, because the fact under test is what the CHECKER charges for the declaration,
    // not what the backend emits. The linkable instance is `std.mem.sizeof` itself, and
    // `check_std_compiled_coverage.sh` compiles a `mem` probe under the full `Std` set
    // (which excludes `Unsafe`) — that probe is what stopped compiling.
    #[intrinsic = "sizeof"]
    pub trusted fn my_sizeof<T>() -> u64;
}
