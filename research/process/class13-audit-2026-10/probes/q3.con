fn f(c: bool) -> i64 {
    let mut x: i64 = 1;
    let r: i64 = if c {
        2
    } else {
        let mut k: i64 = 0;
        while k < 3 { k = k + 1; }
        k
    };
    let mut j: i64 = 0;
    while j < 2 { x = x + j; j = j + 1; }
    return x + r;
}
fn main() with(Console) { println(f(true)); println(f(false)); }
