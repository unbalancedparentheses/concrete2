struct Copy P { x: i64, y: i64 }
struct Copy Q { p: P, z: i64 }
fn get(p: &i64) -> i64 { return *p; }
fn f(c: bool, k: i64) -> i64 {
    let s: P = P { x: k, y: 2 };
    let mut r: i64 = 0;
    if c { r = get(&s.x); }
    return s.x + s.y + r;
}
fn f2(c: bool, k: i64) -> i64 {
    let q: Q = Q { p: P { x: k, y: 2 }, z: 3 };
    let mut r: i64 = 0;
    if c { r = get(&q.p.y); }
    return q.p.x + q.z + r;
}
fn f3(n: i64, k: i64) -> i64 {
    let s: P = P { x: k, y: 2 };
    let mut i: i64 = 0;
    let mut r: i64 = 0;
    while i < n { r = r + get(&s.x); i = i + 1; }
    return s.x + r;
}
fn f4(c: bool, k: i64) -> i64 {
    let a: [i64; 3] = [k, 2, 3];
    let mut r: i64 = 0;
    if c { r = get(&a[1]); }
    return a[0] + r;
}
fn f5(k: i64, s: P) -> i64 {
    let mut r: i64 = 0;
    if k > 5 { r = get(&s.y); }
    return s.x + r;
}
fn main() with(Console) {
    println(f(false, 40)); println(f(true, 40));
    println(f2(false, 40)); println(f2(true, 40));
    println(f3(3, 40)); println(f3(0, 40));
    println(f4(false, 40)); println(f4(true, 40));
    println(f5(1, P { x: 9, y: 4 })); println(f5(9, P { x: 9, y: 4 }));
}
